# --- Excluded from this repo: manuscripts, reference material, internal reports ---
# (code + methods only; see README)
/*.docx
/*.doc
/*.pdf
/reference/
/report_summary/

# Exception: the scripts that generate ACS2026 slide figures are code, so they
# are tracked. Git cannot re-include a file under an excluded directory, so
# each parent level is reopened before the *.py negation.
!/report_summary/
/report_summary/*
!/report_summary/ACS2026/
/report_summary/ACS2026/*
!/report_summary/ACS2026/figures/
/report_summary/ACS2026/figures/*
!/report_summary/ACS2026/figures/*.py

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Partial / temp downloads ---
*.crdownload
*.part
*.tmp
~$*

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
